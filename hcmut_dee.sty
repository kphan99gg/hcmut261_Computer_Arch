% ==============================================================================
% HCMUT FDEE REPORT & THESIS STYLE FILE
% Trường Đại Học Bách Khoa, TP.HCM - Khoa Điện - Điện tử
% Chuẩn hóa theo Hướng dẫn viết Thuyết minh tốt nghiệp (Ban hành 02/01/2024)
% ==============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hcmut_dee}[2026/03/30 HCMUT FDEE Report Style Package]

% ------------------------------------------------------------------------------
% 1. CÁC GÓI THƯ VIỆN CƠ BẢN
% ------------------------------------------------------------------------------
\RequirePackage[utf8]{inputenc}
\RequirePackage[vietnamese,english]{babel} % Hỗ trợ Tiếng Việt và Tiếng Anh
\RequirePackage[T5,T1]{fontenc}
\RequirePackage{mathptmx}                % Font Times New Roman chuẩn cho cả Text và Math

\RequirePackage{amsmath, amssymb, amsfonts} % Công thức toán học
\RequirePackage{graphicx, epsfig, subcaption} % Chèn hình ảnh
\RequirePackage{array, tabularx, booktabs, multirow, multicol, makecell} % Bảng biểu
\RequirePackage{float, caption, setspace}
\RequirePackage{xcolor, listings}       % Mã nguồn C/Matlab/Python
\RequirePackage{tikz}                   % Vẽ hình kỹ thuật
\RequirePackage{lastpage}               % Đánh số trang kiểu X/Y
\RequirePackage{fancyhdr}               % Header & Footer
\RequirePackage{titlesec}               % Định dạng tiêu đề chương mục
\RequirePackage{indentfirst}            % Thụt đầu dòng đoạn văn đầu tiên
\RequirePackage{hyperref}               % Liên kết trang & Bookmark PDF
\RequirePackage{scrextend}
\changefontsizes{13pt} % Ép cỡ chữ chuẩn toàn bài về 13pt

\usetikzlibrary{arrows,backgrounds,positioning,fit,calc}

% ------------------------------------------------------------------------------
% 2. CẤU HÌNH KÍCH THƯỚC TRANG & LỀ (GEOMETRY)
% Theo quy định Khoa ĐĐT: Left=40mm, Right=25mm, Top=40mm, Bottom=25mm (Khổ A4)
% ------------------------------------------------------------------------------
\RequirePackage{geometry}
\geometry{
  a4paper,
  left=30mm,
  right=25mm,
  top=25mm,
  bottom=25mm,
  includehead=false
}

% Cấu hình giãn dòng: 1.3 đối với Tiếng Việt theo quy định
\setstretch{1.3}

% Thụt đầu dòng 5 khoảng trắng (~7.5mm)
\setlength{\parindent}{7.5mm}
\setlength{\parskip}{0pt} % Bỏ khoảng cách đệm giữa các đoạn để chuẩn văn bản

% ------------------------------------------------------------------------------
% 3. ĐỊNH DẠNG TIÊU ĐỀ CHƯƠNG VÀ ĐỀ MỤC (TITLE FORMAT)
% Quy định Khoa:
% - Chương bắt đầu ở trang mới, tiêu đề canh giữa, Font Times 14pt, IN ĐẬM HOÀN TOÀN
% - Tiêu đề các phần (section, subsection) dùng chữ thường in đậm, 13pt
% ------------------------------------------------------------------------------
% Định dạng Chương (Chapter)
\titleformat{\chapter}[block]
  {\normalfont\fontsize{14pt}{\baselineskip}\selectfont\bfseries\centering} % Font 14pt, in đậm, căn giữa
  {\MakeUppercase{\chaptertitlename}\ \thechapter.}               % Chữ "CHƯƠNG X"
  {0.5em}
  {\MakeUppercase}                                               % Tên chương viết hoa toàn bộ

\titlespacing*{\chapter}{0pt}{0pt}{20pt}

% Định dạng Section (Cấp 1) - VD: 1.2
\titleformat{\section}
  {\normalfont\fontsize{13pt}{16pt}\selectfont\bfseries}
  {\thesection}
  {1em}
  {}

% Định dạng Subsection (Cấp 2) - VD: 1.2.3
\titleformat{\subsection}
  {\normalfont\fontsize{13pt}{16pt}\selectfont\bfseries}
  {\thesubsection}
  {1em}
  {}

% Định dạng Subsubsection (Cấp 3) - VD: 1.2.3.4
\titleformat{\subsubsection}
  {\normalfont\fontsize{13pt}{16pt}\selectfont\bfseries}
  {\thesubsubsection}
  {1em}
  {}

% Định dạng Subsubsubsection (Cấp 4) - VD: 1.2.3.4.a
\setcounter{secnumdepth}{3} % Cho phép đánh số đến cấp thứ 43
\setcounter{tocdepth}{3}    % Hiển thị cấp thứ 3 trong Mục lục

\makeatletter
\newcounter{subsubsubsection}[subsubsection]
\renewcommand\thesubsubsubsection{\thesubsubsection.\@alph\c@subsubsubsection}

\newcommand\subsubsubsection{\@startsection{subsubsubsection}{4}{\z@}%
  {-3.25ex \@plus -1ex \@minus -.2ex}%   % Khoảng cách phía trên tiêu đề
  {1.5ex \@plus .2ex}%                   % Khoảng cách phía dưới tiêu đề
  {\normalfont\bfseries\fontsize{13}{16}\selectfont}} % In đậm, cỡ chữ 13pt sát lề trái

\newcommand*\l@subsubsubsection{\@dottedtocline{4}{7.0em}{4.5em}}
\newcommand*{\subsubsubsectionmark}[1]{}
\makeatother

% Chống ngắt trang lỗi cho tiêu đề gần cuối trang (Orphan Control)
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000

% ------------------------------------------------------------------------------
% 4. ĐỊNH DẠNG HEADER & FOOTER (FANCYHDR)
% Đánh số trang liên tiếp, canh giữa ở footer theo quy định
% ------------------------------------------------------------------------------
\setlength{\headheight}{15pt}
\setlength{\headsep}{5mm}
\setlength{\footskip}{5mm}

% Style chuẩn cho nội dung báo cáo
\fancypagestyle{mainstyle}{
  \fancyhf{} % Xóa sạch header/footer mặc định
  \fancyfoot[C]{\thepage} % Đánh số trang canh giữa ở cuối trang
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

% Style dành cho các trang sơ bộ (Mục lục, Tóm tắt...)
\fancypagestyle{preliminary}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

% ------------------------------------------------------------------------------
% 5. ĐỊNH DẠNG CHÚ THÍCH HÌNH ẢNH & BẢNG BIỂU (CAPTIONS)
% Quy định:
% - Bảng: Chú thích NẰM TRÊN bảng
% - Hình: Chú thích NẰM DƯỚI hình
% - Đánh số tuần tự theo từng chapter (vd: Hình 5.1, Bảng 1.2)
% ------------------------------------------------------------------------------
\captionsetup{
  font={normalsize},
  labelfont={bf, rm},
  labelsep=period,
  justification=centering
}

\captionsetup[table]{
  position=top,
  skip=6pt
}

\captionsetup[figure]{
  position=bottom,
  skip=6pt
}

% Tự động gắn số hình/bảng theo chương
\counterwithin{figure}{chapter}
\counterwithin{table}{chapter}
\counterwithin{equation}{chapter}

% ------------------------------------------------------------------------------
% 6. VIỆT HÓA CÁC NHÃN MẶC ĐỊNH
% ------------------------------------------------------------------------------
\AtBeginDocument{
  \selectlanguage{vietnamese}
  \renewcommand*\contentsname{MỤC LỤC}
  \renewcommand*\listfigurename{DANH SÁCH HÌNH MINH HỌA}
  \renewcommand*\listtablename{DANH SÁCH BẢNG SỐ LIỆU}
  \renewcommand*\bibname{TÀI LIỆU THAM KHẢO}
  \renewcommand*\figurename{Hình}
  \renewcommand*\tablename{Bảng}
  \renewcommand*\chaptertitlename{Milestone}
}

% ------------------------------------------------------------------------------
% THÊM TIỀN TỐ "HÌNH" VÀ "BẢNG" BẰNG LỆNH THUẦN LATEX
% ------------------------------------------------------------------------------
\makeatletter
% Ghi thêm chữ "Hình " vào trước số hiệu trong file .lof
\p@figure
\long\def\l@figure#1#2{\@dottedtocline{1}{0pt}{4.5em}{\figurename #1}{#2}}

% Ghi thêm chữ "Bảng " vào trước số hiệu trong file .lot
\long\def\l@table#1#2{\@dottedtocline{1}{0pt}{4.5em}{\tablename #1}{#2}}
\makeatother

% ------------------------------------------------------------------------------
% 7. CẤU HÌNH HIỂN THỊ CODE (LISTINGS - C/C++, MATLAB, PYTHON)
% ------------------------------------------------------------------------------
\definecolor{mGreen}{rgb}{0,0.6,0}
\definecolor{mGray}{rgb}{0.5,0.5,0.5}
\definecolor{mPurple}{rgb}{0.58,0,0.82}
\definecolor{bgCode}{rgb}{0.97,0.97,0.97}

\lstdefinestyle{codeStyle}{
  backgroundcolor=\color{bgCode},
  commentstyle=\color{mGreen}\itshape,
  keywordstyle=\color{blue}\bfseries,
  numberstyle=\tiny\color{mGray},
  stringstyle=\color{mPurple},
  basicstyle=\ttfamily\small,
  breakatwhitespace=false,
  breaklines=true,
  captionpos=b,
  keepspaces=true,
  numbers=left,
  numbersep=5pt,
  showspaces=false,
  showstringspaces=false,
  showtabs=false,
  tabsize=2
}
\lstset{style=codeStyle}

% ------------------------------------------------------------------------------
% 8. CẤU HÌNH LIÊN KẾT HYPERREF
% ------------------------------------------------------------------------------
\hypersetup{
  colorlinks=true,
  linkcolor=black,
  citecolor=blue,
  urlcolor=blue,
  pdfborder={0 0 0}
}

\endinput
